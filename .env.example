DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-client-id

# Optional: register commands instantly to a development server.
GUILD_ID=

# Optional defaults. You can also configure these in Discord with /confessions-config.
DEFAULT_CONFESSION_CHANNEL_ID=
DEFAULT_AUDIT_CHANNEL_ID=
DEFAULT_PING_ROLE_ID=

# Optional: where confession data should be stored.
# For Railway with a mounted volume, use /app/data
DATA_DIR=

# Web dashboard
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=change-me
